# Core application
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/rag_langchain
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# RAG (GOOGLE_API_KEY is required for document processing and chat replies)
GOOGLE_API_KEY=
CHROMA_PERSIST_DIR=chroma_data
CHROMA_COLLECTION_NAME=documents
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_TOP_K=4

# Optional integrations (currently unused)
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CHROMA_HOST=localhost
CHROMA_PORT=8001

# File storage
UPLOAD_DIR=uploads

# Logging
ENV=dev
LOG_JSON=false
LOG_LEVEL=INFO